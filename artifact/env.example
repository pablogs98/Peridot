# Copy to .env next to docker-compose.yml to override any of these.
# The defaults work out of the box; nothing here is secret.

AWS_ACCESS_KEY_ID=peridot
AWS_SECRET_ACCESS_KEY=peridot123
AWS_REGION=us-east-1
S3_BUCKET=peridot-ae

# Required for MinIO and other S3-compatible stores reached by hostname:
# without it the AWS SDK addresses the bucket as <bucket>.<host>, which
# does not resolve. Set to false (or unset) for Amazon S3.
AWS_S3_FORCE_PATH_STYLE=true

# Paper-scale runs. Off by default: see the README for what it costs.
PERIDOT_AE_FULL=0

# To run the storage experiments against any other S3-compatible endpoint,
# set these and skip the minio service. Also the fallback if the bundled MinIO
# image can no longer be pulled:
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# AWS_ENDPOINT_URL=https://s3.us-east-1.amazonaws.com
